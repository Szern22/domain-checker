# Copy this file to .env and fill in what you use. Leave a channel empty to disable it.
# Telegram: create a bot with @BotFather, send it one message, then open
# https://api.telegram.org/bot<TOKEN>/getUpdates to find your chat id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Email (e.g. Gmail: smtp.gmail.com, port 587, use an App Password, not your normal password)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_TO=
